urlbar-action-backup-label = Crea un backup e salva i dati
# Comma-separated keywords that show the address bar action for syncing data. Use English commas.
urlbar-action-sync-keywords = sincronizzazione, dati, sync
# Label of an address bar button that opens a dialog to back up Firefox data.
urlbar-action-sync-label = Sincronizza i tuoi dati
# Title of the first screen of a dialog that helps the user back up Firefox.
backup-spotlight-title = Salviamo i tuoi dati di Firefox
