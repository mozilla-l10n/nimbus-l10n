## Branch: control

# Heading on survey screens 1 to 3 of a short in-product survey shown to new Firefox users. Keep it short: it sits on one line in a narrow panel.
nuts-title = Wie gefällt Ihnen Firefox?
# Survey question. Keep the quoted statement close to the English meaning: Firefox keeps its privacy and security promises.
nuts-q-integrity = Inwieweit stimmen Sie der folgenden Aussage zu oder nicht zu? „Firefox hält seine Versprechen in Bezug auf Datenschutz und Sicherheit ein.“
# Answer option on a 5-point agree/disagree scale.
nuts-scale-strongly-disagree = Stimme überhaupt nicht zu
# Answer option on a 5-point agree/disagree scale.
nuts-scale-disagree = Stimme nicht zu
# Answer option on a 5-point agree/disagree scale.
nuts-scale-neither = Stimme weder zu noch nicht zu
# Answer option on a 5-point agree/disagree scale.
nuts-scale-agree = Stimme zu
# Answer option on a 5-point agree/disagree scale.
nuts-scale-strongly-agree = Stimme voll zu
# Button that moves to the next survey question.
nuts-next = Weiter
# Link to Mozilla's Firefox privacy notice.
nuts-privacy-notice = Datenschutzerklärung
# Survey question. Keep the quoted statement close to the English meaning: Firefox cares about the user, not only about making money.
nuts-q-benevolence = Inwieweit stimmen Sie der folgenden Aussage zu oder nicht zu? „Firefox liegt mein Wohl am Herzen und nicht nur der eigene Gewinn.“
# Survey question about the person's past use of Firefox.
nuts-q-tenure = Welche der folgenden Aussagen beschreibt am besten, wie Sie Firefox bisher genutzt haben?
# Answer option describing how the person has used Firefox in the past.
nuts-tenure-first-time = Ich nutze Firefox erst seit Kurzem
# Answer option describing how the person has used Firefox in the past.
nuts-tenure-stopped-within-year = Ich habe Firefox früher verwendet, aber im letzten Jahr damit aufgehört
# Answer option describing how the person has used Firefox in the past.
nuts-tenure-stopped-over-year = Ich habe Firefox früher genutzt, aber vor über einem Jahr damit aufgehört
# Answer option describing how the person has used Firefox in the past.
nuts-tenure-current-reinstall = Ich nutze Firefox bereits und habe ihn gerade auf diesem Gerät installiert (oder erneut installiert)
