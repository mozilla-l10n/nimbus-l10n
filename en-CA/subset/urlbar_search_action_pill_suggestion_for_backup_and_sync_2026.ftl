## Branch: treatment-a

# Comma-separated keywords that show the address bar action for backing up Firefox. Use English commas.
urlbar-action-backup-keywords = backup, back up, save, data
# Label of an address bar button that opens the backup settings.
urlbar-action-backup-label = Back up and save data
# Comma-separated keywords that show the address bar action for syncing data. Use English commas.
urlbar-action-sync-keywords = sync, data
# Label of an address bar button that opens a dialog to back up Firefox data.
urlbar-action-sync-label = Sync data
# Title of the first screen of a dialog that helps the user back up Firefox.
backup-spotlight-title = Let’s back up your Firefox data
# Description of the backup option in a dialog that helps the user back up Firefox.
backup-spotlight-backup-body = Saves to your device
